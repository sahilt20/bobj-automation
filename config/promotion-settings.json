{
    "raylightApiVersion": "v1",
    "apiEndpoints": {
        "authentication": "/biprws/logon/long",
        "logoff": "/biprws/logoff",
        "raylightAbout": "/biprws/raylight/v1/about",
        "raylightDocuments": "/biprws/raylight/v1/documents",
        "infostore": "/biprws/infostore",
        "promotion": "/biprws/promotion",
        "promotionTest": "/biprws/promotion/{id}/test",
        "promotionExecute": "/biprws/promotion/{id}/promote",
        "promotionResults": "/biprws/promotion/{id}/results",
        "promotionDownload": "/biprws/promotion/{id}/lcmbiar"
    },
    "defaultSettings": {
        "includeSecurityRights": true,
        "includeDependencies": true,
        "includeConnections": true,
        "includeUniverses": true
    },
    "conflictResolution": {
        "default": "UpdateExisting",
        "options": {
            "UpdateExisting": "Overwrite existing objects with same CUID",
            "SkipExisting": "Keep existing objects, skip duplicates",
            "RenameNew": "Rename incoming objects to avoid conflicts",
            "Fail": "Fail the promotion if conflicts exist"
        },
        "apiMapping": {
            "UpdateExisting": "overwrite",
            "SkipExisting": "skip",
            "RenameNew": "rename",
            "Fail": "fail"
        }
    },
    "securityOptions": {
        "overwriteSecurityOnImport": false,
        "preserveOwnership": true,
        "applyTargetSecurity": false
    },
    "objectTypes": {
        "include": ["Report", "Universe", "Connection", "Folder", "Category", "Publication"],
        "exclude": ["Inbox", "PersonalCategory"]
    },
    "retry": {
        "maxAttempts": 3,
        "delaySeconds": 30,
        "exponentialBackoff": true
    },
    "jobSettings": {
        "maxConcurrentJobs": 1,
        "jobPollingIntervalSeconds": 10,
        "jobTimeoutMinutes": 60,
        "sessionTimeoutSeconds": 3600,
        "tokenRefreshMarginSeconds": 300
    },
    "checksumAlgorithm": "SHA256"
}
