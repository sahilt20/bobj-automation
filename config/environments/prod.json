{
    "name": "Production",
    "description": "SAP BusinessObjects Production Environment",
    "server": {
        "url": "https://bobj-prod.example.com:8080",
        "cmsServer": "bobj-prod-cms.example.com",
        "cmsPort": 6400,
        "cluster": "PROD_CLUSTER"
    },
    "raylightApi": {
        "basePath": "/biprws/raylight/v1",
        "promotionPath": "/biprws/promotion",
        "infostorePath": "/biprws/infostore"
    },
    "authentication": {
        "type": "secEnterprise",
        "keyVault": "kv-bobj-prod"
    },
    "exportSettings": { "timeout": 45 },
    "importSettings": { "timeout": 90, "conflictResolution": "UpdateExisting", "createBackup": true },
    "approval": { "required": true, "approverGroups": ["BOBJ-Prod-Approvers", "BOBJ-Release-Managers"], "minimumApprovers": 2, "timeoutMinutes": 2880 },
    "deploymentWindow": { "enabled": true, "timezone": "UTC", "startHour": 6, "endHour": 18, "allowedDays": ["Monday","Tuesday","Wednesday","Thursday"] },
    "notifications": { "teams": { "enabled": true }, "email": { "enabled": true, "recipients": ["prod-team@example.com", "bobj-admins@example.com"] } },
    "agentPool": "BOBJ-Prod-Agents"
}
