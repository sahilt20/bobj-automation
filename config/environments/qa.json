{
    "name": "Quality Assurance",
    "description": "SAP BusinessObjects QA/Staging Environment",
    "server": {
        "url": "https://bobj-qa.example.com:8080",
        "cmsServer": "bobj-qa-cms.example.com",
        "cmsPort": 6400,
        "cluster": "QA_CLUSTER"
    },
    "raylightApi": {
        "basePath": "/biprws/raylight/v1",
        "promotionPath": "/biprws/promotion",
        "infostorePath": "/biprws/infostore"
    },
    "authentication": {
        "type": "secEnterprise",
        "keyVault": "kv-bobj-qa"
    },
    "exportSettings": { "timeout": 30 },
    "importSettings": { "timeout": 60, "conflictResolution": "UpdateExisting", "createBackup": true },
    "approval": { "required": true, "approverGroups": ["BOBJ-QA-Approvers"], "minimumApprovers": 1, "timeoutMinutes": 1440 },
    "notifications": { "teams": { "enabled": true }, "email": { "enabled": true, "recipients": ["qa-team@example.com"] } },
    "agentPool": "BOBJ-QA-Agents"
}
