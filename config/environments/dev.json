{
    "name": "Development",
    "description": "SAP BusinessObjects Development Environment",
    "server": {
        "url": "https://bobj-dev.example.com:8080",
        "cmsServer": "bobj-dev-cms.example.com",
        "cmsPort": 6400,
        "cluster": "DEV_CLUSTER"
    },
    "raylightApi": {
        "basePath": "/biprws/raylight/v1",
        "promotionPath": "/biprws/promotion",
        "infostorePath": "/biprws/infostore"
    },
    "authentication": {
        "type": "secEnterprise",
        "keyVault": "kv-bobj-dev"
    },
    "exportSettings": { "timeout": 30 },
    "importSettings": { "timeout": 45, "conflictResolution": "UpdateExisting" },
    "approval": { "required": false },
    "notifications": { "teams": { "enabled": true }, "email": { "enabled": false } },
    "agentPool": "BOBJ-Dev-Agents"
}
