{
    "info": {
        "_postman_id": "bobj-rest-api",
        "name": "SAP BOBJ REST API",
        "description": "Collection for testing SAP BusinessObjects REST Web Services.\n\n⚠️ IMPORTANT (SAP BI 2025): The biprws REST API does NOT support LCM promotion or import operations. Those endpoints (/biprws/lcm/*) do not exist and will return RWS 00005 (Not Found).\n\nFor LCM operations (export/import LCMBIAR), use the LCMCLI command-line tool instead.\n\nThis collection covers only the supported biprws endpoints: Authentication, InfoStore browsing, and system connectivity testing.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Logon",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.environment.set(\"logonToken\", jsonData.logonToken);",
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test(\"Logon token received\", function () {",
                                    "    pm.expect(jsonData.logonToken).to.not.be.undefined;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"userName\": \"{{username}}\",\n    \"password\": \"{{password}}\",\n    \"auth\": \"{{authType}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/biprws/logon/long",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "biprws",
                                "logon",
                                "long"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Logoff",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "X-SAP-LogonToken",
                                "value": "{{logonToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/biprws/logoff",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "biprws",
                                "logoff"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "InfoStore",
            "item": [
                {
                    "name": "Get API Root",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "pm.test(\"API root is accessible\", function () {",
                                    "    pm.expect(pm.response.text()).to.not.be.empty;",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/biprws",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "biprws"
                            ]
                        },
                        "description": "Test that the biprws REST API root is accessible. This does not require authentication."
                    },
                    "response": []
                },
                {
                    "name": "Get InfoStore",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-SAP-LogonToken",
                                "value": "{{logonToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/biprws/infostore",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "biprws",
                                "infostore"
                            ]
                        },
                        "description": "Browse the InfoStore root. Requires a valid logon token."
                    },
                    "response": []
                },
                {
                    "name": "Get Folder Contents",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-SAP-LogonToken",
                                "value": "{{logonToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/biprws/infostore/folder?path=/Public Folders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "biprws",
                                "infostore",
                                "folder"
                            ],
                            "query": [
                                {
                                    "key": "path",
                                    "value": "/Public Folders"
                                }
                            ]
                        },
                        "description": "Get contents of a specific folder by path."
                    },
                    "response": []
                },
                {
                    "name": "Get Object by CUID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "X-SAP-LogonToken",
                                "value": "{{logonToken}}"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/biprws/infostore/cuid_{{objectCuid}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "biprws",
                                "infostore",
                                "cuid_{{objectCuid}}"
                            ]
                        },
                        "description": "Retrieve a specific object by its CUID. Set the 'objectCuid' variable first."
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://your-bobj-server:8080",
            "type": "string",
            "description": "Base URL for the BOBJ Web Application Server (typically port 8080 for Tomcat)"
        },
        {
            "key": "username",
            "value": "Administrator",
            "type": "string"
        },
        {
            "key": "password",
            "value": "",
            "type": "string"
        },
        {
            "key": "authType",
            "value": "secEnterprise",
            "type": "string"
        },
        {
            "key": "objectCuid",
            "value": "",
            "type": "string",
            "description": "CUID of an object to look up (used by Get Object by CUID request)"
        }
    ]
}